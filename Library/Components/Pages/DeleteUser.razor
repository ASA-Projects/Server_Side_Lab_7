@page "/users/delete/{Id:int}"
@rendermode InteractiveServer
@inject LibraryService LibraryService
@inject NavigationManager Navigation

<PageTitle>Delete User</PageTitle>

@if (user == null)
{
    <p>User not found. <a href="/users">Back to users</a></p>
}
else
{
    <h1>Delete User</h1>
    <p>Are you sure you want to delete <strong>@user.Name</strong> (@user.Email)?</p>
    <FormBody Model="user" OnValidSubmit="Delete" SubmitText="Delete" SubmitClass="btn-danger" CancelUrl="/users" />
}

@code {
    [Parameter] public int Id { get; set; }
    private User? user;

    protected override void OnParametersSet()
    {
        user = LibraryService.GetUser(Id);
    }

    private void Delete()
    {
        if (user == null) return;
        LibraryService.DeleteUser(Id);
        Navigation.NavigateTo("/users");
    }
}
