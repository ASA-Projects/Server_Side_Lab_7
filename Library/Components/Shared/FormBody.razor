<EditForm Model="Model" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    @ChildContent
    <div class="mt-3">
        <button type="submit" class="btn @SubmitClass">@SubmitText</button>
        <a href="@CancelUrl" class="btn btn-secondary ms-2">Cancel</a>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired] public object Model { get; set; } = default!;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<EditContext> OnValidSubmit { get; set; }
    [Parameter] public string SubmitText { get; set; } = "Save";
    [Parameter] public string SubmitClass { get; set; } = "btn-primary";
    [Parameter] public string CancelUrl { get; set; } = "/";
}
